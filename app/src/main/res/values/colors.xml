<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        ZamboSafe palette (LIGHT mode). Change colors HERE (and in values-night/colors.xml).
        Everything else in the app references these three names via the theme.

        zs_primary   = backgrounds / card surfaces
        zs_secondary = borders, hints, small labels
        zs_tertiary  = main text, filled buttons, selected chips
    -->
    <color name="zs_primary">#EEEEEE</color>   <!-- RGB 238, 238, 238 -->
    <color name="zs_secondary">#828282</color> <!-- RGB 130, 130, 130 -->
    <color name="zs_tertiary">#111111</color>  <!-- RGB 17, 17, 17 -->

    <!-- Accent colors: category tags (LIGHT mode) -->
    <color name="tag_red">#C62828</color>
    <color name="tag_blue">#1565C0</color>
    <color name="tag_orange">#E65100</color>
    <color name="tag_yellow">#FFD600</color>
    <color name="tag_outline">#FF000000</color>
    <color name="tag_green">#2E7D32</color>

    <!-- Accent colors: action buttons -->
    <color name="btn_call">#2E7D32</color>
    <color name="btn_facebook">#1877F2</color>
    <color name="btn_website">#6B6B6B</color>
    <color name="btn_text">#FFFFFFFF</color>
    <color name="action_hint_bg">#323232</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
